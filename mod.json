{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "bebet.click-buffer",
	"name": "Click Buffer",
	"version": "v1.0.0",
	"developer": "Bebet",
	"description": "Guarda clics anticipados del cubo y los ejecuta al aterrizar.",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Activado",
			"default": true
		},
		"buffer-frames": {
			"type": "int",
			"name": "Frames de buffer (a 60 FPS)",
			"default": 3,
			"min": 1,
			"max": 15
		},
		"show-indicator": {
			"type": "bool",
			"name": "Indicador visual",
			"default": true
		}
	}
}